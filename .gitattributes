# Force LF line endings for all text files — prevents CRLF vs LF
# merge conflicts between Windows and macOS teammates.
* text=auto eol=lf

# Explicitly LF
*.tsx    text eol=lf
*.ts     text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env*   text eol=lf
*.sh     text eol=lf

# Diffs
*.tsx diff=typescript
*.ts  diff=typescript
*.css diff=css
*.md  diff=markdown

# Binary — do not touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.woff binary
*.woff2 binary
