# SUTURA Frontend — Environment Variables
#
# macOS / Git Bash:
#   cp .env.example .env.local
#
# Windows CMD:
#   copy .env.example .env.local
#
# Then open .env.local and verify the API URL below matches
# where your Laravel server is running.

# Backend API URL (Laravel server)
# - Default for local dev: http://127.0.0.1:8000/api/v1
# - If port 8000 has a conflict on Windows (e.g. `php artisan serve --port=8080`):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
